<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowBackground is the cellar dark, so launching never flashes a
         white screen before Compose draws. Bars stay transparent: the app
         draws edge-to-edge and pads for insets itself. -->
    <style name="Theme.Cellar" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/cellar_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
